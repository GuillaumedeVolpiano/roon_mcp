-- For working on this package and the libraries it is built on at the same
-- time: cabal build --project-file=cabal.project.siblings
packages: .

-- The libraries roon-mcp is built on, when they are checked out next to it.
optional-packages:
  ../roon-api
  ../effectful-mcp
  ../effectful-streamly
  ../effectful-streamly-http
  ../effectful-websockets
  ../streamly-http
  ../streamly-network-udp
  ../streamly-websockets
  ../streamly-network-tcp
  ../streamly-flatparse
